# Copy to .env.local. These are publishable (anon) keys — they ship in the
# browser bundle by design, and RLS is what actually protects the data.

# ── DB B — the CMS database (DailyMattr CMS, ap-south-1) ─────────────
# Users, categories, content items (article/pix/qix/trax), the approved
# app feed and the audit log.
NEXT_PUBLIC_SUPABASE_URL=https://ijnlvyctwgdvsedpejva.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_9pUq4c9Yb7OgN3p4DJMMbw_T7ELat-U

# ── DB A — NewsStudio pipeline (Shortly-email-agent) ─────────────────
# READ ONLY. The agent pipeline owns this database; the CMS only selects
# from it. Editorial changes are stored as overrides in DB B instead.
NEXT_PUBLIC_NEWSSTUDIO_URL=https://ygxdrphajvrbjcaxhvcn.supabase.co
NEXT_PUBLIC_NEWSSTUDIO_ANON_KEY=sb_publishable_U5bF6OWzRqiZw6j8c9hQsw_s3byk-tR

# ── Server only — never prefixed NEXT_PUBLIC ────────────────────────
# Lets the Team page create sign-in accounts (app/api/users). It bypasses RLS
# entirely, so it must never reach the browser: no NEXT_PUBLIC_ prefix, and the
# route checks the caller is a super admin before it is used at all.
# Supabase → Project Settings → API → service_role.
# Without it, adding a member still records the profile but cannot create their
# login, and the Studio says so.
SUPABASE_SERVICE_ROLE_KEY=
